      {"id": 6501, "code": "name", "name": "Name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
      {"id": 6502, "code": "lastname", "name": "Last name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
      {"id": 6503, "code": "email", "name": "Email", "type": "email", "validate": "checkout", "enabled": true, "required": true},
      {"id": 6511, "code": "address", "name": "Address", "type": "text", "validate": "address", "enabled": true, "required": true},
      {"id": 6512, "code": "zipcode", "name": "Zipcode", "type": "text", "validate": "address", "enabled": true, "required": false},
      {"id": 6513, "code": "internal_number", "name": "Internal number", "type": "text", "validate": "address", "enabled": true, "required": false},
      {"id": 6514, "code": "address_notes", "name": "Address notes", "type": "text", "validate": "address", "enabled": true, "required": false}
    ]
  },
