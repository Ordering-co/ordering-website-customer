      "response": { "error": false, "result": { "id": 9301, "name": "Synthetic Favorites", "lastname": "Synthetic Customer", "email": "docs@e.invalid", "cellphone": "2025550199", "country_phone_code": "1", "enabled": true, "email_verified": true, "phone_verified": true, "session": { "access_token": "docs-fixture-favorites-businesses-token" } } }
