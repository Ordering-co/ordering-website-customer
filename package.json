    "docs:website:business-details:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/business-details.spec.js",
    "docs:website:schedule-preorder:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/schedule-preorder.spec.js",
    "docs:website:customize-product:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/customize-product.spec.js",
    "docs:website:manage-cart:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/manage-cart.spec.js",
    "docs:website:multi-cart:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/multi-cart.spec.js",
    "docs:website:payment-methods:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/payment-methods.spec.js",
    "docs:website:complete-checkout:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/complete-checkout.spec.js",
    "docs:website:multi-checkout:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/multi-checkout.spec.js",
    "docs:website:sign-in-create-account:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/sign-in-create-account.spec.js",
    "docs:website:reset-password:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/reset-password.spec.js",
    "docs:website:verification-profile-completion:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/verification-profile-completion.spec.js",
    "docs:website:profile:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/profile.spec.js",
    "docs:website:addresses:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/addresses.spec.js",
    "docs:website:saved-cards:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/saved-cards.spec.js",
    "docs:website:sessions:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/sessions.spec.js",
    "docs:website:favorites:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/favorites.spec.js",
    "docs:website:wallets:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/wallets.spec.js",
    "docs:website:order-history:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/order-history.spec.js",
    "docs:website:order-details-tracking:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/order-details-tracking.spec.js",
    "docs:website:cancel-order:assert": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/cancel-order.spec.js",
    "docs:website:reorder-reviews:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/reorder-reviews.spec.js",
    "docs:website:messages:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/messages.spec.js",
    "docs:website:help-content-pages:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/help-content-pages.spec.js",
    "docs:website:global-states:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/global-states.spec.js",
    "docs:website:website-modes:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/website-modes.spec.js",
    "docs:website:business-driver-signup:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/business-driver-signup.spec.js",
    "docs:website:custom-orders:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/custom-orders.spec.js",
    "docs:website:school-student-ordering:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/school-student-ordering.spec.js",
    "docs:website:appointments-professionals:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/appointments-professionals.spec.js",
    "docs:website:integration-login:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/integration-login.spec.js",
    "prepare": "husky",
    "cf:dev": "wrangler dev",
    "cf:prepare": "git submodule update --init --recursive && pnpm install --frozen-lockfile && pnpm theme:verify && pnpm build",
    "cf:build:production": "SENTRY_RELEASE=$(git rev-parse HEAD) pnpm cf:prepare",
    "cf:build:development": "pnpm cf:prepare",
    "theme:compile": "ordering-theme compile product.schema.json --v1-map docs/theme-v2/mapa-v1-para-api-core.json --out src/theme.compiled.json",
    "theme:verify": "pnpm theme:compile --check",
    "theme:css-catalog": "node scripts/theme-css-catalog.mjs",
    "theme:validate": "ordering-theme validate product.schema.json --v1-map docs/theme-v2/mapa-v1-para-api-core.json",
    "design:check": "node scripts/design/guard.mjs --check",
    "design:baseline": "node scripts/design/guard.mjs --update-baseline && node scripts/design/generate-exceptions-doc.mjs",
    "design:report": "node scripts/design/guard.mjs --report",
    "design:test": "node --test tests/design/*.test.mjs",
    "design:coherence": "node scripts/design/coherence.mjs",
    "design:ratchet": "node scripts/design/baseline-ratchet.mjs",
    "marketplace:test": "node --test tests/marketplace/*.test.mjs",
    "marketplace:start": "node scripts/marketplace/cli.mjs start",
    "marketplace:restore": "node scripts/marketplace/cli.mjs restore",
    "marketplace:doctor": "node scripts/marketplace/cli.mjs doctor",
    "marketplace:configure": "node scripts/marketplace/cli.mjs configure",
    "marketplace:connection": "node scripts/marketplace/cli.mjs connection"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ordering-co/ordering-website-customer.git"
