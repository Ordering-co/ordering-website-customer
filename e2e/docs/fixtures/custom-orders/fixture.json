      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": [
          { "id": 9921, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 9921, "code": "name", "name": "Name", "type": "text" } },
          { "id": 9922, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 9922, "code": "lastname", "name": "Last name", "type": "text" } },
          { "id": 9923, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 9923, "code": "email", "name": "Email", "type": "email" } }
        ]
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": {
          "id": 9301,
          "name": "Synthetic Customer",
          "lastname": "Synthetic Profile",
          "email": "docs@e.invalid",
          "cellphone": "2025550199",
          "country_phone_code": "1",
          "birthdate": "2000-01-01",
          "enabled": true,
          "email_verified": true,
          "phone_verified": true,
          "addresses": [
            {
              "id": 9701,
              "user_id": 9301,
              "address": "200 Synthetic Delivery Way, Docs City",
              "location": { "lat": 30.2672, "lng": -97.7431 },
              "country_code": "US",
              "default": true
            }
          ],
          "session": { "access_token": "docs-fixture-custom-order-session-token" }
        }
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/order_options(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": {
          "user_id": 9301,
          "type": 1,
          "address_id": 9701,
          "address": {
            "id": 9701,
            "user_id": 9301,
            "address": "200 Synthetic Delivery Way, Docs City",
            "location": { "lat": 30.2672, "lng": -97.7431 },
            "country_code": "US",
            "default": true
          },
          "carts": []
