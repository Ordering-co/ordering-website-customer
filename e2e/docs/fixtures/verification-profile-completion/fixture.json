{
  "extends": "account",
  "apiOrigins": ["https://api.docs.invalid", "https://google-redirect.plugins.orderingplus.com"],
  "localStorage": {
    "local_phone_code": "+1"
  },
  "authSession": {
    "token": "docs-fixture-verification-profile-token",
    "user": {
      "id": 9301,
      "name": "Synthetic Profile Customer",
      "lastname": "",
      "email": "docs@e.invalid",
      "cellphone": "2025550199",
      "country_phone_code": "1",
      "enabled": true,
      "email_verified": true,
      "phone_verified": true,
      "session": {"access_token": "docs-fixture-verification-profile-token"}
    }
  },
  "firstLoad": {
    "configs": {
      "whatsapp_otp_login_enabled": {"key": "whatsapp_otp_login_enabled", "value": "0"}
    }
  },
  "appendRoutes": [
    {
      "method": "GET",
      "origin": "https://google-redirect.plugins.orderingplus.com",
      "pattern": "^/docsmarket/api/frontend/settings(?:\\?.*)?$",
      "assert": { "count": 0 },
      "response": { "error": false, "result": {} }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/paymethods(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": { "error": false, "result": [] }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/validation_field_order_types(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": [
          {
            "id": 6309,
            "order_type_id": 1,
            "enabled": true,
            "required": true,
            "required_with_guest": false,
            "validation_field": { "id": 6310, "code": "name", "name": "Name", "type": "text" }
          },
          {
            "id": 6311,
            "order_type_id": 1,
            "enabled": true,
            "required": true,
            "required_with_guest": false,
            "validation_field": { "id": 6312, "code": "lastname", "name": "Last name", "type": "text" }
          }
        ]
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": {
        "error": false,
        "result": {
          "id": 9301,
          "name": "Synthetic Profile Customer",
          "lastname": "",
          "email": "docs@e.invalid",
          "cellphone": "2025550199",
          "country_phone_code": "1",
          "enabled": true,
          "email_verified": true,
          "phone_verified": true,
          "session": { "access_token": "docs-fixture-verification-profile-token" }
        }
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/order_options(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 2 },
      "response": { "error": false, "result": { "user_id": 9301, "type": null, "carts": [] } }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301/addresses(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": [] }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/codes/generate$",
      "assert": { "count": 0 },
      "response": { "error": true, "result": ["Synthetic verification code was not sent."] }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/users/9301/verify$",
      "assert": { "count": 0 },
      "response": { "error": true, "result": ["Synthetic verification was not completed."] }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/auth/sms/twilio/verify$",
      "assert": { "count": 0 },
      "response": { "error": true, "result": ["Synthetic phone verification was not sent."] }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/auth/logout$",
      "assert": { "count": 0 },
      "response": { "error": true, "result": ["Synthetic session remained active."] }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/users/9301$",
      "assert": { "count": 0 },
      "response": { "error": true, "result": ["Synthetic profile was not changed."] }
    }
  ]
}
