{
  "name": "orderingx-website-marketplace",
  "version": "1.0.0",
  "description": "This repository is a template marketplace using functional components.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && vite build -c vite.ssr.config.js",
    "preview": "vite preview --port 3000",
    "serve": "vite preview --port 3000",
    "prod": "pnpm build && pnpm preview",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest --run --pool=forks",
    "test:watch": "vitest",
    "size:entry": "node scripts/entry-size.mjs",
    "test:web:browser": "playwright test --config=playwright.web.config.js --project=w390 --project=w1440",
    "test:web:browser:matrix": "playwright test --config=playwright.web.config.js",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest --coverage --run --pool=forks",
    "test:coverage:summary": "node scripts/coverage-summary.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "i18n:generate": "node i18n/generate.cjs",
    "i18n:check-generated": "node i18n/check-generated.cjs",
    "i18n:verify": "node i18n/verify.cjs",
    "i18n:missing": "node i18n/missing.cjs",
    "i18n:apply-batch": "node i18n/applyBatch.cjs",
    "i18n:sync": "node i18n/sync.cjs --dry-run",
    "i18n:sync:live": "node i18n/sync.cjs --live",
    "i18n:demo-e2e": "node i18n/demo-local-e2e.cjs",
    "docs:website:contract": "node --test e2e/docs/tests/*.test.js",
    "docs:website:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js",
    "docs:website:overview:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/website-overview.spec.js",
    "docs:website:choose-location-order-type:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/choose-location-order-type.spec.js",
    "docs:website:browse-businesses:capture": "pnpm docs:website:contract && playwright test --config=playwright.docs.config.js e2e/docs/specs/browse-businesses.spec.js",
