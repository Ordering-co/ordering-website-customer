        "site": {
          "third_party_code": {
            "head": "",
            "body": ""
          }
        }
      }
    },
    "validation_fields": [
      {"id": 9921, "code": "name", "name": "Name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
