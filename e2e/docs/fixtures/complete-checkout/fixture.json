{
  "extends": "payment-methods",
  "firstLoad": {
    "configs": {
      "driver_tip_enabled": {"key": "driver_tip_enabled", "value": "0"},
      "wallet_enabled": {"key": "wallet_enabled", "value": "0"},
      "cash_wallet": {"key": "cash_wallet", "value": "0"}
    }
  },
  "appendRoutes": [
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/carts/synthetic-cart-checkout/place$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": {
        "error": true,
        "result": ["Synthetic checkout stopped before order creation."]
      }
    }
  ]
}
