{
  "extends": "common",
  "localStorage": {
    "options": "{\"type\":1,\"address\":{\"address\":\"100 Synthetic Market Street, Test City, TX 78701\",\"zipcode\":\"78701\",\"country_code\":\"US\",\"location\":{\"lat\":30.2672,\"lng\":-97.7431}}}"
  },
  "firstLoad": {
    "configs": {
      "default_order_type": {"type": 1},
      "unaddressed_order_types_allowed": {"key": "unaddressed_order_types_allowed", "value": "1|2"},
      "general_hour_format": {"key": "general_hour_format", "value": "hh:mm a"},
      "currency": {"key": "currency", "value": "USD"},
      "currency_position": {"key": "currency_position", "value": "left"},
      "currency_decimal_separator": {"key": "currency_decimal_separator", "value": "."},
      "currency_thousand_separator": {"key": "currency_thousand_separator", "value": ","},
      "currency_number_decimals": {"key": "currency_number_decimals", "value": "2"}
    },
    "site": {
      "business_url_template": "/store/:business_slug"
    }
  },
  "scenarioResponses": {
    "error": {
      "error": true,
      "result": ["Synthetic offers are temporarily unavailable."],
      "pagination": null
    },
    "empty": {
      "error": false,
      "result": [],
      "pagination": null
    }
  },
  "routes": [
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/offers/public(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": [
          {
            "id": 8401,
            "name": "Synthetic Summer Savings",
            "description": "Save on a synthetic marketplace order.",
            "start": "2026-08-01 00:00:00",
            "end": "2026-08-31 23:59:59",
            "image": "",
            "type": 2,
            "coupon": "SYNTHETIC20",
            "rate_type": 1,
            "rate": 20,
            "target": 1,
            "auto": false,
            "minimum": 25,
            "max_discount": 15,
            "businesses": [
              { "id": 8101, "name": "Synthetic Kitchen", "slug": "synthetic-kitchen", "logo": "" },
              { "id": 8102, "name": "Fixture Bakery", "slug": "fixture-bakery", "logo": "" }
            ]
          },
          {
            "id": 8402,
            "name": "Fixture Delivery Credit",
            "description": "A synthetic fixed credit for delivery fees.",
            "start": "2026-08-01 00:00:00",
            "end": "2026-09-15 23:59:59",
            "image": "",
            "type": 1,
            "coupon": "",
            "rate_type": 2,
            "rate": 5,
            "target": 2,
            "auto": true,
            "minimum": 0,
            "max_discount": 0,
            "businesses": [
              { "id": 8101, "name": "Synthetic Kitchen", "slug": "synthetic-kitchen", "logo": "" }
            ]
          }
        ],
        "pagination": null
      }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/tracking_events$",
      "assert": { "count": 0 },
      "response": { "error": false, "result": { "id": "synthetic-tracking-event" } }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/banner(?:\\?.*)?$",
      "response": { "error": false, "result": [] }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/business_types(?:\\?.*)?$",
      "response": {
        "error": false,
        "result": [],
        "pagination": { "current_page": 1, "total_pages": 1, "total": 0, "page_size": 25 }
      }
    },
    {
      "method": "GET",
      "pattern": "^/docsmarket/api/frontend/settings(?:\\?.*)?$",
      "response": { "error": false, "result": {} }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/paymethods(?:\\?.*)?$",
      "response": { "error": false, "result": [] }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/orders(?:\\?.*)?$",
      "response": {
        "error": false,
        "result": [],
        "pagination": { "current_page": 1, "total_pages": 1, "total": 0, "page_size": 10 }
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/countries(?:\\?.*)?$",
      "response": { "error": false, "result": [] }
    }
  ]
}
