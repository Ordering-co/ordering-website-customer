      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301/addresses(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": {
        "error": false,
        "result": [{ "id": 9701, "user_id": 9301, "address": "200 Synthetic Delivery Way, Docs City", "location": { "lat": 30.2672, "lng": -97.7431 }, "country_code": "US", "default": true }]
