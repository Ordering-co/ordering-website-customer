{
  "extends": "customize-product",
  "firstLoad": {
    "configs": {
      "disabled_rewards": {"key": "disabled_rewards", "value": "1"},
      "checkout_multi_business_enabled": {"key": "checkout_multi_business_enabled", "value": "0"}
    }
  },
  "appendRoutes": [
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/business/8301/products(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": [] }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/business/8301(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": { "id": 8301, "slug": "synthetic-market", "name": "Synthetic Market Kitchen", "configs": [] } }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/delivery_options(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": [] }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/configs(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": [] }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/carts/synthetic-cart-manage/upselling(?:\\?.*)?$",
      "response": { "error": false, "result": [] }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/carts/update_product$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": {} }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/carts/remove_product$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": {} }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/carts/clear$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": {} }
    },
    {
      "method": "PUT",
      "pattern": "^/v400/en/docsmarket/carts/synthetic-cart-manage$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": {} }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/loyalty_plans(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": [] }
    }
  ]
}
