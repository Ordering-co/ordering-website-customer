{
  "extends": "account",
  "apiOrigins": ["https://api.docs.invalid", "https://google-redirect.plugins.orderingplus.com"],
  "runtimeConfig": {
    "app_id": "docs-fixture-website-app",
    "app_internal_name": "website"
  },
  "localStorage": {
    "local_phone_code": "+1"
  },
  "authSession": {
    "token": "docs-fixture-favorites-businesses-token",
    "user": {
      "id": 9301,
      "name": "Synthetic Favorites",
      "lastname": "Synthetic Customer",
      "email": "docs@e.invalid",
      "cellphone": "2025550199",
      "country_phone_code": "1",
      "enabled": true,
      "email_verified": true,
      "phone_verified": true,
      "session": {"access_token": "docs-fixture-favorites-businesses-token"}
    }
  },
  "firstLoad": {
    "configs": {
      "default_order_type": {"value": "pickup"},
      "preorder_status_enabled": {"key": "preorder_status_enabled", "value": "1"},
      "general_hour_format": {"key": "general_hour_format", "value": "hh:mm a"}
    },
    "theme": {
      "values": {
        "tokens": {
          "layout": {
            "mode": "original"
          }
        },
        "visibility": {
          "orders.review_order_button": false,
          "orders.reorder_button": false
        }
      }
    },
    "validation_fields": [
      {"id": 7801, "code": "name", "name": "Name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
      {"id": 7802, "code": "lastname", "name": "Last name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
      {"id": 7803, "code": "email", "name": "Email", "type": "email", "validate": "checkout", "enabled": true, "required": true}
    ]
  },
  "appendRoutes": [
    { "method": "GET", "pattern": "^/docsmarket/api/frontend/settings(?:\\?.*)?$", "assert": { "count": 0 }, "response": { "error": false, "result": {} } },
    { "method": "GET", "pattern": "^/v400/en/docsmarket/paymethods(?:\\?.*)?$", "assert": { "count": 1 }, "response": { "error": false, "result": [] } },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/validation_field_order_types(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": [
          { "id": 7811, "order_type_id": 2, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 7801, "code": "name", "name": "Name", "type": "text" } },
          { "id": 7812, "order_type_id": 2, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 7802, "code": "lastname", "name": "Last name", "type": "text" } },
          { "id": 7813, "order_type_id": 2, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 7803, "code": "email", "name": "Email", "type": "email" } }
        ]
