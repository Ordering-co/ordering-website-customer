    "options": "{\"type\":1,\"address\":{\"address\":\"100 Synthetic Market Street, Fixture City\",\"zipcode\":\"TEST-000\",\"country_code\":\"ZZ\",\"location\":{\"lat\":12.3456,\"lng\":-45.6789}}}"
  },
  "firstLoad": {
    "configs": {
      "default_order_type": {"type": 1},
      "unaddressed_order_types_allowed": {"key": "unaddressed_order_types_allowed", "value": "1|2"},
      "add_product_with_one_click": {"key": "add_product_with_one_click", "value": "0", "enabled": false},
      "general_hour_format": {"key": "general_hour_format", "value": "hh:mm a"},
      "currency": {"key": "currency", "value": "USD"},
      "currency_position": {"key": "currency_position", "value": "left"},
      "currency_decimal_separator": {"key": "currency_decimal_separator", "value": "."},
      "currency_thousand_separator": {"key": "currency_thousand_separator", "value": ","},
      "currency_number_decimals": {"key": "currency_number_decimals", "value": "2"},
      "format_number_currency": {"key": "format_number_currency", "value": "$"},
      "distance_unit": {"key": "distance_unit", "value": "km"},
      "filter_search_options": {"key": "filter_search_options", "value": "price_range|brands|max_delivery_fee|max_delivery_time|max_distance|business_categories"},
      "location_default_latitude": {"key": "location_default_latitude", "value": "12.3456"},
      "location_default_longitude": {"key": "location_default_longitude", "value": "-45.6789"},
      "google_maps_api_key": {"key": "google_maps_api_key", "value": "docs-fixture-google-key"},
      "preorder_status_enabled": {"key": "preorder_status_enabled", "value": "0"},
      "max_product_amount": {"key": "max_product_amount", "value": "100"}
    },
    "site": {
      "business_url_template": "/store/:business_slug",
      "product_url_template": "/store/:business_slug?category=:category_id&product=:product_id"
    },
    "theme": {
      "values": {
        "visibility": {
          "business_listing.cities": false
        }
      }
    }
  },
