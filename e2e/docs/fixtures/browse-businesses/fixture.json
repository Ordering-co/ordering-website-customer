{
  "extends": "common",
  "apiOrigins": ["https://api.docs.invalid", "https://api.mapbox.com", "https://google-redirect.plugins.orderingplus.com"],
  "firstLoad": {
    "theme": {
      "values": {
        "components": {
          "business_listing_page": { "base": { "layout": "grid", "rows": 3 } }
        }
      }
    },
    "configs": {
      "default_order_type": {"type": 1},
      "unaddressed_order_types_allowed": {"key": "unaddressed_order_types_allowed", "value": "1|2"},
      "use_alternative_to_google_maps": {"key": "use_alternative_to_google_maps", "value": "1"},
      "map_box_token": {"key": "map_box_token", "value": "docs-fixture-mapbox-token"},
      "google_autocomplete_selection_required": {"key": "google_autocomplete_selection_required", "value": "1"},
      "preorder_status_enabled": {"key": "preorder_status_enabled", "value": "1"},
      "max_days_preorder": {"key": "max_days_preorder", "value": "7"},
      "general_hour_format": {"key": "general_hour_format", "value": "hh:mm a"},
      "advanced_business_search_enabled": {"key": "advanced_business_search_enabled", "value": "0"},
      "activate_single_store_automatically": {"key": "activate_single_store_automatically", "value": "0"},
      "filter_search_options": {"key": "filter_search_options", "value": "price_range|max_delivery_fee|max_delivery_time|max_distance|business_categories"},
      "location_default_latitude": {"key": "location_default_latitude", "value": "30.2672"},
      "location_default_longitude": {"key": "location_default_longitude", "value": "-97.7431"}
    }
  },
  "edgeXhr": {
    "translations": {
      "result": {"WHERE_DO_WE_DELIVERY": "Where do we deliver?"}
    }
  },
