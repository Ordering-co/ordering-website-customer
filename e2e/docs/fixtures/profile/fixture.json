{
  "extends": "account",
  "apiOrigins": ["https://api.docs.invalid", "https://google-redirect.plugins.orderingplus.com"],
  "localStorage": {
    "local_phone_code": "+1"
  },
  "authSession": {
    "token": "docs-fixture-profile-session-token",
    "user": {
      "id": 9301,
      "name": "Synthetic Profile",
      "lastname": "Synthetic Customer",
      "email": "docs@e.invalid",
      "cellphone": "2025550199",
      "country_phone_code": "1",
      "birthdate": "2000-01-01",
      "enabled": true,
      "email_verified": true,
      "phone_verified": true,
      "session": {"access_token": "docs-fixture-profile-session-token"}
    }
  },
  "firstLoad": {
    "validation_fields": [
      {"id": 6411, "code": "name", "name": "Name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
      {"id": 6412, "code": "lastname", "name": "Last name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
      {"id": 6413, "code": "email", "name": "Email", "type": "email", "validate": "checkout", "enabled": true, "required": true},
      {"id": 6414, "code": "cellphone", "name": "Phone", "type": "text", "validate": "checkout", "enabled": true, "required": false},
      {"id": 6415, "code": "birthdate", "name": "Birthdate", "type": "date", "validate": "checkout", "enabled": true, "required": false}
    ]
  },
  "appendRoutes": [
    {
      "method": "GET",
      "pattern": "^/docsmarket/api/frontend/settings(?:\\?.*)?$",
      "assert": { "count": 0 },
      "response": { "error": false, "result": {} }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/paymethods(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": { "error": false, "result": [] }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/validation_field_order_types(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": [
          { "id": 6401, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 6411, "code": "name", "name": "Name", "type": "text" } },
          { "id": 6402, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 6412, "code": "lastname", "name": "Last name", "type": "text" } },
          { "id": 6403, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 6413, "code": "email", "name": "Email", "type": "email" } },
          { "id": 6404, "order_type_id": 1, "enabled": true, "required": false, "required_with_guest": false, "validation_field": { "id": 6414, "code": "cellphone", "name": "Phone", "type": "text" } },
          { "id": 6405, "order_type_id": 1, "enabled": true, "required": false, "required_with_guest": false, "validation_field": { "id": 6415, "code": "birthdate", "name": "Birthdate", "type": "date" } }
        ]
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301(?:\\?.*)?$",
      "assert": { "count": 2 },
      "response": {
        "error": false,
        "result": {
          "id": 9301,
          "name": "Synthetic Profile",
          "lastname": "Synthetic Customer",
          "email": "docs@e.invalid",
          "cellphone": "2025550199",
          "country_phone_code": "1",
          "birthdate": "2000-01-01",
          "enabled": true,
          "email_verified": true,
          "phone_verified": true,
          "session": { "access_token": "docs-fixture-profile-session-token" }
        }
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/order_options(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 2 },
      "response": { "error": false, "result": { "user_id": 9301, "type": 2, "carts": [] } }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301/addresses(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": [] }
    },
    {
      "method": "POST",
      "pattern": "^/v400/en/docsmarket/users/9301$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": {
        "error": false,
        "result": {
          "id": 9301,
          "name": "Synthetic Updated Name",
          "lastname": "Synthetic Customer",
          "email": "docs@e.invalid",
          "cellphone": "2025550199",
          "country_phone_code": "1",
          "birthdate": "2000-01-01",
          "enabled": true,
          "email_verified": true,
          "phone_verified": true,
          "session": { "access_token": "docs-fixture-profile-session-token" }
        }
      }
    },
    { "method": "POST", "pattern": "^/v400/en/docsmarket/auth/sms/twilio/verify$", "assert": { "count": 0 }, "response": { "error": true, "result": ["Synthetic phone verification was not sent."] } },
    { "method": "POST", "pattern": "^/v400/en/docsmarket/auth/logout$", "assert": { "count": 0 }, "response": { "error": true, "result": ["Synthetic session remained active."] } },
    { "method": "POST", "pattern": "^/v400/en/docsmarket/codes/generate$", "assert": { "count": 0 }, "response": { "error": true, "result": ["Synthetic verification code was not sent."] } }
  ]
}
