{
  "extends": "account",
  "apiOrigins": ["https://api.docs.invalid", "https://google-redirect.plugins.orderingplus.com"],
  "runtimeConfig": {
    "app_id": "docs-fixture-website-app",
    "app_internal_name": "website"
  },
  "localStorage": {
    "local_phone_code": "+1"
  },
  "authSession": {
    "token": "docs-fixture-saved-cards-list-token",
    "user": {
      "id": 9301,
      "name": "Synthetic Cards",
      "lastname": "Synthetic Customer",
      "email": "docs@e.invalid",
      "cellphone": "2025550199",
      "country_phone_code": "1",
      "enabled": true,
      "email_verified": true,
      "phone_verified": true,
      "session": {"access_token": "docs-fixture-saved-cards-list-token"}
    }
  },
  "firstLoad": {
    "validation_fields": [
      {"id": 7601, "code": "name", "name": "Name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
      {"id": 7602, "code": "lastname", "name": "Last name", "type": "text", "validate": "checkout", "enabled": true, "required": true},
      {"id": 7603, "code": "email", "name": "Email", "type": "email", "validate": "checkout", "enabled": true, "required": true}
    ]
  },
  "appendRoutes": [
    {
      "method": "GET",
      "pattern": "^/docsmarket/api/frontend/settings(?:\\?.*)?$",
      "assert": { "count": 0 },
      "response": { "error": false, "result": {} }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/paymethods(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": [
          { "id": 61, "name": "Synthetic vaulted cards", "gateway": "braintree", "featured": ["get_cards"], "enabled": true }
        ]
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/validation_field_order_types(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": [
          { "id": 7611, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 7601, "code": "name", "name": "Name", "type": "text" } },
          { "id": 7612, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 7602, "code": "lastname", "name": "Last name", "type": "text" } },
          { "id": 7613, "order_type_id": 1, "enabled": true, "required": true, "required_with_guest": false, "validation_field": { "id": 7603, "code": "email", "name": "Email", "type": "email" } }
        ]
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": {
          "id": 9301,
          "name": "Synthetic Cards",
          "lastname": "Synthetic Customer",
          "email": "docs@e.invalid",
          "cellphone": "2025550199",
          "country_phone_code": "1",
          "enabled": true,
          "email_verified": true,
          "phone_verified": true,
          "session": { "access_token": "docs-fixture-saved-cards-list-token" }
        }
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/order_options(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 2 },
      "response": { "error": false, "result": { "user_id": 9301, "type": 2, "carts": [] } }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301/addresses(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "response": { "error": false, "result": [] }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301/paymethods/61/paymethods$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": [
          { "id": 9501, "external_id": "docs-fixture-card-reference-9501", "type": "card", "type_data": { "brand": "visa", "last4": "0000" } },
          { "id": 9502, "external_id": "docs-fixture-card-reference-9502", "type": "card", "type_data": { "brand": "mastercard", "last4": "0011" } }
        ]
      }
    },
    {
      "method": "DELETE",
      "pattern": "^/v400/en/docsmarket/users/9301/paymethods/61/paymethods/9502$",
      "assert": { "count": 0 },
      "response": { "error": false, "result": "OK" }
    }
  ]
}
