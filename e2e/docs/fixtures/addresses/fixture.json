        ]
      }
    },
    {
      "method": "GET",
      "pattern": "^/v400/en/docsmarket/users/9301(?:\\?.*)?$",
      "assert": { "count": 1 },
      "response": {
        "error": false,
        "result": {
          "id": 9301,
          "name": "Synthetic Profile",
          "lastname": "Synthetic Customer",
