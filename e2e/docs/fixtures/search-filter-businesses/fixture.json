    {
      "method": "GET",
      "pattern": "^/maps/api/js(?:\\?.*)?$",
      "assert": { "minCount": 0, "maxCount": 1 },
      "transport": {
        "contentType": "application/javascript",
        "body": "(() => { class LatLng { constructor(lat, lng) { this._lat = Number(lat); this._lng = Number(lng); } lat() { return this._lat; } lng() { return this._lng; } } class LatLngBounds { constructor() { this.points = []; } extend(point) { this.points.push(point); } isEmpty() { return this.points.length === 0; } } class Map { constructor(element) { this.element = element; element.setAttribute('data-doc-map-ready', 'true'); element.style.cssText += ';position:relative;background-color:#e8efe9;background-image:linear-gradient(28deg,transparent 46%,#fff 47%,#fff 52%,transparent 53%),linear-gradient(118deg,transparent 46%,#d5e2d8 47%,#d5e2d8 52%,transparent 53%),linear-gradient(#dfe9e1 1px,transparent 1px),linear-gradient(90deg,#dfe9e1 1px,transparent 1px);background-size:240px 180px,300px 220px,48px 48px,48px 48px'; } fitBounds() {} setCenter() {} setZoom() {} } class Marker { constructor(options) { this.position = options.position; this.map = options.map; this.listeners = {}; const marker = document.createElement('button'); marker.type = 'button'; marker.setAttribute('aria-label', 'Synthetic business map marker'); marker.setAttribute('data-doc-control', 'business-search-map-marker'); marker.style.cssText = 'position:absolute;left:' + (42 + document.querySelectorAll('[data-doc-control=business-search-map-marker]').length * 12) + '%;top:48%;width:34px;height:34px;border-radius:50%;border:3px solid white;background:#2f6f5e;box-shadow:0 2px 8px rgba(0,0,0,.3);z-index:3'; marker.addEventListener('click', () => this.listeners.click && this.listeners.click()); options.map.element.appendChild(marker); this.element = marker; } addListener(name, listener) { this.listeners[name] = listener; } setMap() { this.element && this.element.remove(); } getPosition() { return this.position; } } class InfoWindow { setContent(content) { this.content = content; } open() {} close() {} addListener() {} } class Size { constructor(width, height) { this.width = width; this.height = height; } } window.google = { maps: { Map, Marker, LatLng, LatLngBounds, InfoWindow, Size } }; setTimeout(() => window.googleAsyncInit && window.googleAsyncInit(), 0); })();"
      }
    },
